root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = tab

[*.{md,yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
# Markdown uses trailing spaces for hard line breaks; verify.sh flags them, so
# keep them out of this repo and use explicit blank lines instead.
trim_trailing_whitespace = true

[Makefile]
indent_style = tab
